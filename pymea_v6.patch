+        except (ValueError, pd.errors.ParserError):
+            return None  # landed mid-line (record length is not constant): fall back to streaming
+    if frame.empty or abs(frame.iloc[0, 0] / 1000.0 - first_row * step_s) > 0.25 * step_s:
