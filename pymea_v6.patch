+                "--sheet-dir",
+                str(out),
+                "--annotations",
+                str(out / "A.csv"),
+                "--out",
+                str(out / "results.json"),
+            ]
+        )
+        == 0
+    )
+    assert "vs_annotator" in json.loads((out / "results.json").read_text(encoding="utf-8"))
