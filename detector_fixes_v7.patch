+    max_lag = min(len(autocorr) - 1, int(round(hi_s * fs_hz)))
+    if max_lag <= min_lag:
+        return None
+    region = autocorr[min_lag : max_lag + 1]
+    if not np.any(np.isfinite(region)):
+        return None
+    peak_indices, _ = signal.find_peaks(region, prominence=0.02)
+    if len(peak_indices) == 0:
